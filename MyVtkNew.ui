QTabBar::tab{
border: 0px solid #000000;
color:#ffffff;
margin:0px;
min-width:545;
min-height:80;
font: 26pt &quot;思源黑体 CN Regular&quot;;
font-weight:normal;

padding: 1px;
border-top-left-radius: 5px;
border-top-right-radius: 5px;
border-bottom-left-radius: 0px;
border-bottom-right-radius: 0px;
background-color: rgb(58, 64, 78);
}

QTabWidget::pane{
border:1px solid #242424;
selection-background-color:#606C7A;
selection-color:#606C7A;
alternate-background-color:#525252;
gridline-color:#242424;
}

QTabBar::tab:hover{

}
QTabBar::tab:selected{
border-style:solid;

background-color: rgb(96, 108, 122);
}

QTabBar::tab:first:top:selected,QTabBar::tab:first:top:hover,QTabBar::tab:first:bottom:selected,QTabBar::tab:first:bottom:hover{
border-left-width:1px;
border-left-color:#797979;
}

